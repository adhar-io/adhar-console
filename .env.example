# Path to the adhar-ui checkout (sibling repo). Used by Vite resolve.alias in apps/console.
ADHAR_UI_PATH=../../Adhar/AdharWS/adhar-ui

# ═══════════════════════════════════════════════════════════════════════════
# LOCAL DEV against the running adhar cluster.
#
# `pnpm dev` runs the BFF (Deno server) on :5099 alongside Vite (:5100); the
# Vite host proxies /api/* to it. There is NO stub fallback — the console talks
# to the REAL local cluster. Copy this file to `.env` and fill the values below
# (mainly AUTH_CLIENT_SECRET from the cluster's keycloak-clients secret).
#
# Prereqs for a local kind-based adhar cluster:
#   • Cluster reachable at *.adhar.localtest.me:8443 (localtest.me → 127.0.0.1).
#   • The apiserver reachable from your host — set K8S_API_URL to your kube
#     context's server (e.g. https://127.0.0.1:6443) and DENO_CERT to a bundle
#     trusting the apiserver CA + Keycloak's cert (see K8S/DENO_CERT below).
#   • Postgres reachable at DATABASE_URL (port-forward console-db, or run
#     `docker compose -f deploy/compose/docker-compose.yml up`).
#   • The Keycloak `adhar-console` client must allow the dev redirect URI
#     http://localhost:5100/api/auth/callback (added in keycloak-config.yaml).
# ═══════════════════════════════════════════════════════════════════════════

# ── Auth / SSO (server-side, confidential OIDC client) ───────────────────────
KEYCLOAK_URL=https://keycloak.adhar.localtest.me:8443
KEYCLOAK_REALM=adhar
KEYCLOAK_CLIENT_ID=adhar-console
# Confidential client secret (required for real SSO).
AUTH_CLIENT_SECRET=
# Signs session + transaction cookies. >= 32 chars, same on every replica.
# Generate: openssl rand -base64 48
AUTH_COOKIE_SECRET=
# External origin of the console (used to build the OIDC redirect_uri).
# For LOCAL DEV this is the Vite host origin. In production set it to the
# console's real ingress (https://console.adhar.localtest.me:8443).
AUTH_PUBLIC_URL=http://localhost:5100
# Dev is plain HTTP on localhost, so the Secure cookie flag must be off (a
# Secure cookie is dropped over http). Defaults to true in production.
AUTH_COOKIE_SECURE=false
# Space-separated scopes. offline_access enables server-side refresh tokens.
AUTH_SCOPES=openid profile email offline_access
# Sliding session cookie lifetime in seconds (default 28800 = 8h).
AUTH_SESSION_TTL_SECONDS=28800
# Absolute session ceiling in seconds — a session can't be refresh-extended past
# this; forces a fresh interactive login (default 86400 = 24h).
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=86400
# NOTE: KEYCLOAK_CLIENT_ID must match a real Keycloak client. The platform
# provisions a dedicated `adhar-console` confidential client whose access tokens
# carry aud=kubernetes + groups (see keycloak-config.yaml); its secret is
# AUTH_CLIENT_SECRET above.

# ── Backing OSS tool endpoints ───────────────────────────────────────────────
# A tool with no URL set is "not configured": its BFF proxy route returns 503
# and the module renders an empty/error state (no stub fallback).
GITEA_URL=https://gitea.adhar.localtest.me:8443
ARGOCD_URL=https://argocd.adhar.localtest.me:8443
KARGO_URL=https://kargo.adhar.localtest.me:8443
HARBOR_URL=https://harbor.adhar.localtest.me:8443
PLANE_URL=https://plane.adhar.localtest.me:8443
ARGO_WORKFLOWS_URL=https://workflows.adhar.localtest.me:8443
ARGO_ROLLOUTS_URL=https://rollouts.adhar.localtest.me:8443
METABASE_URL=https://metabase.adhar.localtest.me:8443
AIRBYTE_URL=https://airbyte.adhar.localtest.me:8443
CODER_URL=https://coder.adhar.localtest.me:8443
# OpenCost / Kubecost allocation API (Decide → cost/spend). Dev via the gateway
# host, or an in-cluster svc such as http://opencost.opencost.svc:9003.
OPENCOST_URL=https://opencost.adhar.localtest.me:8443
# OpenCost's REST API needs no auth by default; only set a token if it is
# fronted by an authenticating proxy.
OPENCOST_TOKEN=
# Optional: monthly cost budget (USD) the spend view tracks against. Unset ⇒
# the budget gauge shows "not configured" (never a fabricated budget). This is
# a client build-time var, so it must be prefixed VITE_.
VITE_OPENCOST_MONTHLY_BUDGET=

# ── Component scaffolder (Catalog → Create) ──────────────────────────────────
# Where scaffolded repos are created + where template repos live (Gitea org).
GITEA_ORG=platform
# Namespace/project the scaffolder creates Argo CD Applications in, and the
# default target namespace for GitOps deploys. Requires GITEA_TOKEN (above) for
# repo creation; the Argo CD Application is created as the signed-in user.
ARGOCD_NAMESPACE=argocd
ARGOCD_PROJECT=default
SCAFFOLD_DEST_NAMESPACE=default

# Per-tool auth mode override: "user" (forward the user's token) | "service".
# GITEA_AUTH_MODE=service
# KARGO_AUTH_MODE=user

# Service tokens (used when a tool runs in `service` auth mode). See
# deploy/k8s/secret.example.yaml — keep these out of source control.
GITEA_TOKEN=
ARGOCD_TOKEN=
HARBOR_TOKEN=
PLANE_TOKEN=

# ── LGTM observability (Discover phase) ──────────────────────────────────────
GRAFANA_URL=https://grafana.adhar.localtest.me:8443
LOKI_URL=https://loki.adhar.localtest.me:8443
MIMIR_URL=https://mimir.adhar.localtest.me:8443
TEMPO_URL=https://tempo.adhar.localtest.me:8443
PROMETHEUS_URL=https://prometheus.adhar.localtest.me:8443

# ── Kubernetes API access ────────────────────────────────────────────────────
# LOCAL DEV (out-of-cluster): point at your kube context's apiserver. For a kind
# cluster this is usually https://127.0.0.1:<port> — find it with
#   kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}'
K8S_API_URL=https://127.0.0.1:6443
# DENO_CERT: a PEM bundle Deno trusts for BOTH the apiserver AND Keycloak's
# self-signed HTTPS. Export the apiserver CA + the adhar gateway CA into one file:
#   kubectl config view --minify --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}' | base64 -d > /tmp/adhar-ca.crt
#   # append the gateway/keycloak CA too if it differs
# Then set DENO_CERT=/tmp/adhar-ca.crt. In-cluster this is /shared/ca-bundle.crt.
DENO_CERT=/tmp/adhar-ca.crt
# In-cluster (prod) the apiserver is https://kubernetes.default.svc with the
# projected SA token; K8S_SA_TOKEN is normally unset (user-token impersonation).
K8S_SA_TOKEN=
# The Kubernetes UI authenticates to the apiserver AS THE SIGNED-IN USER
# (per-user OIDC impersonation) — their Keycloak token (with the apiserver's
# oidc-client-id as audience) is forwarded by the /api/k8s gateway. No console
# ServiceAccount privilege is used for user-facing calls.

# ── AI assistant (self-hosted / OpenAI-compatible) ───────────────────────────
# Leave AI_BASE_URL empty to disable AI. Point it at any OpenAI-compatible
# endpoint (vLLM, Ollama /v1, LiteLLM, LocalAI). Read-only cluster tool-use +
# human-approved change proposals only.
AI_BASE_URL=
AI_MODEL=default
AI_API_KEY=

# ── Postgres (Drizzle) — console's own state ─────────────────────────────────
# Stores the console's OWN state: preferences, notification state, user
# directory, AND the document store (OKRs, saved views, custom roles, webhooks,
# design docs, API specs — /api/store/*). REQUIRED — those features return 503
# without it (no stub fallback). Live infra state still comes from the K8s API.
# For local dev, port-forward the cluster's console-db, or run local Postgres:
#   docker compose -f deploy/compose/docker-compose.yml up
DATABASE_URL=postgres://adhar:adhar@localhost:5432/adhar_console
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10
# Set DATABASE_PREPARE=false behind a transaction-mode pooler (PgBouncer).
# DATABASE_PREPARE=false
