# Path to the adhar-ui checkout (sibling repo). Used by Vite resolve.alias in apps/console.
ADHAR_UI_PATH=../../Adhar/AdharWS/adhar-ui

# ── Auth / SSO (server-side, confidential OIDC client) ───────────────────────
# When these are set, the production server runs real Keycloak SSO. When unset,
# the dev SPA falls back to a stub "demo user" (no server, no Keycloak).
KEYCLOAK_URL=https://keycloak.adhar.local
KEYCLOAK_REALM=adhar
KEYCLOAK_CLIENT_ID=adhar-console
# Confidential client secret (required for real SSO).
AUTH_CLIENT_SECRET=
# Signs session + transaction cookies. >= 32 chars, same on every replica.
# Generate: openssl rand -base64 48
AUTH_COOKIE_SECRET=
# External origin of the console (used to build the OIDC redirect_uri).
# REQUIRED in production — the server refuses to derive it from request headers
# there (X-Forwarded-Host is forgeable → open redirect). Dev may omit it.
AUTH_PUBLIC_URL=https://console.adhar.local
# Set "false" only for local non-TLS testing; defaults to true in production.
# When secure, the session cookie uses the __Host- prefix automatically.
AUTH_COOKIE_SECURE=
# Space-separated scopes. offline_access enables server-side refresh tokens.
AUTH_SCOPES=openid profile email offline_access
# Sliding session cookie lifetime in seconds (default 28800 = 8h).
AUTH_SESSION_TTL_SECONDS=28800
# Absolute session ceiling in seconds — a session can't be refresh-extended past
# this; forces a fresh interactive login (default 86400 = 24h).
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=86400
# NOTE: KEYCLOAK_CLIENT_ID must match the Keycloak client whose audience the
# id_token carries. On the Adhar platform that client is `backstage` — set
# KEYCLOAK_CLIENT_ID=backstage there, or id_token audience verification fails.

# ── Backing OSS tool endpoints ───────────────────────────────────────────────
# A tool with no URL set is "not configured": its BFF proxy route returns 503
# and the module renders an empty/error state (dev still shows stub fixtures).
GITEA_URL=https://gitea.adhar.local
ARGOCD_URL=https://argocd.adhar.local
KARGO_URL=https://kargo.adhar.local
HARBOR_URL=https://harbor.adhar.local
PLANE_URL=https://plane.adhar.local
ARGO_WORKFLOWS_URL=https://workflows.adhar.local
ARGO_ROLLOUTS_URL=https://rollouts.adhar.local
METABASE_URL=https://metabase.adhar.local
AIRBYTE_URL=https://airbyte.adhar.local
CODER_URL=https://coder.adhar.local

# Per-tool auth mode override: "user" (forward the user's token) | "service".
# GITEA_AUTH_MODE=service
# KARGO_AUTH_MODE=user

# Service tokens (used when a tool runs in `service` auth mode). See
# deploy/k8s/secret.example.yaml — keep these out of source control.
GITEA_TOKEN=
ARGOCD_TOKEN=
HARBOR_TOKEN=
PLANE_TOKEN=

# ── LGTM observability (Discover phase) ──────────────────────────────────────
GRAFANA_URL=https://grafana.adhar.local
LOKI_URL=https://loki.adhar.local
MIMIR_URL=https://mimir.adhar.local
TEMPO_URL=https://tempo.adhar.local
PROMETHEUS_URL=https://prometheus.adhar.local

# ── Kubernetes API access ────────────────────────────────────────────────────
# In-cluster (default): the apiserver is reached at https://kubernetes.default.svc
# and the projected SA token is read automatically. Set DENO_CERT to the SA CA
# so Deno trusts the apiserver TLS (the deployment manifest does this for you).
K8S_API_URL=https://kubernetes.default.svc
# Out-of-cluster: point K8S_API_URL at a reachable apiserver / kube-rbac-proxy
# and provide K8S_SA_TOKEN.
K8S_SA_TOKEN=
# The Kubernetes UI authenticates to the apiserver AS THE SIGNED-IN USER
# (per-user OIDC impersonation) — their Keycloak token (with the apiserver's
# oidc-client-id as audience) is forwarded by the /api/k8s gateway. No console
# ServiceAccount privilege is used for user-facing calls.

# ── AI assistant (self-hosted / OpenAI-compatible) ───────────────────────────
# Leave AI_BASE_URL empty to disable AI. Point it at any OpenAI-compatible
# endpoint (vLLM, Ollama /v1, LiteLLM, LocalAI). Read-only cluster tool-use +
# human-approved change proposals only.
AI_BASE_URL=
AI_MODEL=default
AI_API_KEY=

# ── Postgres (Drizzle) — console's own state ─────────────────────────────────
# Stores preferences, notification read/dismiss state, user directory, etc.
# Live infra state still comes from the K8s API, not here. When unset, the app
# runs without persistence (dev falls back to localStorage).
#   docker compose -f deploy/compose/docker-compose.yml up   ← local Postgres
DATABASE_URL=postgres://adhar:adhar@localhost:5432/adhar_console
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10
# Set DATABASE_PREPARE=false behind a transaction-mode pooler (PgBouncer).
# DATABASE_PREPARE=false
