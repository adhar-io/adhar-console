    "@tanstack/react-router": "npm:@tanstack/react-router@^1.167.0",
    "@tanstack/react-start": "npm:@tanstack/react-start@^1.167.0",
    "@tanstack/react-start/client": "npm:@tanstack/react-start@^1.167.0/client",
    "@tanstack/react-start/server": "npm:@tanstack/react-start@^1.167.0/server",
    "@tanstack/react-query": "npm:@tanstack/react-query@^5.59.0",
