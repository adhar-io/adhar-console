{
  "nodeModulesDir": "auto",
  "workspace": [
    "./packages/tsconfig",
    "./packages/eslint-config",
    "./packages/utils",
    "./packages/auth",
    "./packages/db",
    "./packages/tenancy",
    "./packages/shell-ui",
    "./packages/mf-utils",
    "./packages/platform-info",
    "./packages/build-config",
    "./packages/api-clients",
    "./apps/console",
    "./apps/launch",
    "./modules/define",
    "./modules/design",
    "./modules/develop",
    "./modules/deliver",
    "./modules/discover",
    "./modules/decide",
    "./modules/platform",
    "./modules/workspace"
  ],
  "tasks": {
    "dev": "deno run -A scripts/dev.ts",
    "build": "deno run -A scripts/build.ts",
    "check": "deno check packages/**/src/index.ts modules/*/src/index.ts",
    "test": "deno test --allow-read --allow-env --allow-net packages/ modules/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "clean": "rm -rf packages/*/dist packages/api-clients/*/dist modules/*/dist apps/*/.output apps/*/.vinxi apps/*/node_modules/.vite apps/*/node_modules/__mf__virtual modules/*/node_modules/.vite modules/*/node_modules/__mf__virtual",
    "console:dev": "cd apps/console && deno task dev",
    "console:build": "cd apps/console && deno task build",
    "launch:dev": "deno run -A scripts/dev.ts launch-api launch",
    "launch:build": "cd apps/launch && deno task build",
    "launch:serve": "cd apps/launch && deno task serve",
    "preview": "cd apps/console && deno run -A .output/server/index.mjs"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom", "dom.iterable", "es2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": [
      "**/dist/",
      "**/.output/",
      "**/.vinxi/",
      "**/node_modules/",
      "**/generated/"
    ]
  },
  "lint": {
    "include": ["packages/", "modules/", "apps/"],
    "exclude": ["**/dist/", "**/.output/", "**/.vinxi/", "**/node_modules/", "**/generated/"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "imports": {
    "@adhar/utils": "./packages/utils/src/index.ts",
    "@adhar/auth": "./packages/auth/src/index.ts",
    "@adhar/auth/server": "./packages/auth/src/server-index.ts",
    "@adhar/db": "./packages/db/src/index.ts",
    "@adhar/tenancy": "./packages/tenancy/src/index.ts",
    "@adhar/shell-ui": "./packages/shell-ui/src/index.ts",
    "@adhar/mf-utils": "./packages/mf-utils/src/index.ts",
    "@adhar/platform-info": "./packages/platform-info/src/index.ts",
    "@adhar/build-config": "./packages/build-config/src/index.ts",
    "@adhar/build-config/remote": "./packages/build-config/src/remote.ts",
    "@adhar/build-config/host": "./packages/build-config/src/host.ts",
    "@adhar/build-config/registry": "./packages/build-config/src/registry.ts",
    "@adhar/api-clients": "./packages/api-clients/src/index.ts",
    "@adhar/api-clients/workspace": "./packages/api-clients/src/workspace/index.ts",
    "@adhar/api-clients/gitea": "./packages/api-clients/src/gitea/index.ts",
    "@adhar/api-clients/plane": "./packages/api-clients/src/plane/index.ts",
    "@adhar/api-clients/argocd": "./packages/api-clients/src/argocd/index.ts",
    "@adhar/api-clients/kargo": "./packages/api-clients/src/kargo/index.ts",
    "@adhar/api-clients/harbor": "./packages/api-clients/src/harbor/index.ts",
    "@adhar/api-clients/k8s": "./packages/api-clients/src/k8s/index.ts",
    "@adhar/api-clients/kyverno": "./packages/api-clients/src/kyverno/index.ts",
    "@adhar/api-clients/crossplane": "./packages/api-clients/src/crossplane/index.ts",
    "@adhar/api-clients/argo-workflows": "./packages/api-clients/src/argo-workflows/index.ts",
    "@adhar/api-clients/argo-rollouts": "./packages/api-clients/src/argo-rollouts/index.ts",
    "@adhar/api-clients/lgtm": "./packages/api-clients/src/lgtm/index.ts",
    "jose": "npm:jose@^5.9.6",
    "drizzle-orm": "npm:drizzle-orm@^0.36.4",
    "drizzle-orm/": "npm:/drizzle-orm@^0.36.4/",
    "postgres": "npm:postgres@^3.4.5",
    "clsx": "npm:clsx@^2.1.1",
    "tailwind-merge": "npm:tailwind-merge@^2.5.0"
  }
}
