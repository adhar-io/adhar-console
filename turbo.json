{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vinxi/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "check": {
      "dependsOn": ["^check"]
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "DENO_ENV",
    "ADHAR_UI_PATH",
    "KEYCLOAK_URL",
    "KEYCLOAK_REALM",
    "KEYCLOAK_CLIENT_ID",
    "KEYCLOAK_CLIENT_SECRET",
    "GITEA_URL",
    "ARGOCD_URL",
    "KARGO_URL",
    "HARBOR_URL",
    "PLANE_URL",
    "K8S_IN_CLUSTER",
    "KUBECONFIG"
  ]
}
